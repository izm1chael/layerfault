{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layerfault.dev/schemas/policy.json",
  "title": "Layerfault Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile"],
  "properties": {
    "version": {"const": 1},
    "profile": {"enum": ["permissive", "workstation", "ci", "strict", "personal_local", "research", "enterprise", "production", "air_gapped", "high_assurance"]},
    "require_trusted_attestation": {"type": ["boolean", "null"]},
    "block_unknown_layers": {"type": ["boolean", "null"]},
    "block_on_warnings": {"type": ["boolean", "null"]},
    "allowed_model_patterns": {"type":"array","items":{"type":"string","minLength":1}},
    "denied_rule_ids": {"type":"array","items":{"type":"string","minLength":1}},
    "allowed_sources": {"type":"array","items":{"type":"string","minLength":1}},
    "allowed_formats": {"type":"array","items":{"type":"string","minLength":1}},
    "allowed_architectures": {"type":"array","items":{"type":"string","minLength":1}},
    "allowed_quantizations": {"type":"array","items":{"type":"string","minLength":1}},
    "max_model_bytes": {"type":["integer","null"],"minimum":1},
    "minimum_trusted_signatures": {"type":["integer","null"],"minimum":0,"maximum":32},
    "required_signer_fingerprints": {"type":"array","items":{"type":"string","pattern":"^sha256:[0-9a-fA-F]{64}$"}},
    "block_finding_classes": {"type":"array","items":{"enum":["Integrity","Structural","ContentIndicator","Policy","Attestation","Compatibility","Operational","Informational"]}},
    "block_confidence_at_or_above": {"type":["string","null"],"enum":["Low","Medium","High",null]},
    "require_complete_coverage": {"type":["boolean","null"]},
    "require_current_intelligence": {"type":["boolean","null"]},
    "max_intelligence_age_days": {"type":["integer","null"],"minimum":0},
    "block_known_runtime_exploitability": {"type":["boolean","null"]},
    "require_runtime_compatibility": {"type":["boolean","null"]},
    "allow_custom_code": {"type":["boolean","null"]},
    "require_pinned_remote_revision": {"type":["boolean","null"]},
    "require_admission_receipt": {"type":["boolean","null"]},
    "require_layered_identity": {"type":["boolean","null"]},
    "require_lineage_for_derived_models": {"type":["boolean","null"]},
    "require_complete_composition": {"type":["boolean","null"]},
    "require_independent_adapter_scan": {"type":["boolean","null"]},
    "allow_unsigned_adapters": {"type":["boolean","null"]},
    "require_verified_provenance": {"type":["boolean","null"]},
    "require_complete_agent_capabilities": {"type":["boolean","null"]},
    "block_dangerous_capability_chains": {"type":["boolean","null"]},
    "denied_capability_chain_ids": {"type":"array","items":{"type":"string","minLength":1}},
    "require_behavioural_assurance": {"type":["boolean","null"]},
    "require_fresh_evidence": {"type":["boolean","null"]},
    "backdoor_signal_action": {"type":["string","null"],"enum":["ignore","warn","block_multi_signal","block_any_reproducible_trigger",null]},
    "suppressions": {
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["rule_id","reason"],
        "properties":{
          "rule_id":{"type":"string","minLength":1},
          "model":{"type":"string","default":"*"},
          "reason":{"type":"string","minLength":8},
          "owner":{"type":["string","null"]},
          "reference":{"type":["string","null"]},
          "expires_unix":{"type":["integer","null"],"minimum":1}
        }
      }
    }
  }
}
